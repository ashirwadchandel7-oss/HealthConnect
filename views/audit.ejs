<%- include('partials/header', { title: 'Audit log | HealthConnect Bharat' }) %>
<main class="dashboard-wrap"><section class="panel workflow-panel"><a class="back-link" href="/admin">← Admin dashboard</a><span class="eyebrow">Security & operations</span><h1>Audit log</h1><form method="get" action="/admin/audit" class="directory-search"><label>Action or record type<input name="q" value="<%= query %>" maxlength="80"></label><button class="button primary">Filter</button></form>
  <% if(logs.length){ %><div class="workflow-list"><% logs.forEach((log)=>{ %><article class="workflow-card"><div><strong><%= log.action %></strong><p><%= log.entity_type %> #<%= log.entity_id||'—' %> · Actor: <%= log.actor_name||'system' %> (#<%= log.actor_id||'—' %>)</p><small><%= formatDateTime(log.created_at) %></small><% if(log.details_json){ %><pre class="audit-details"><%= typeof log.details_json==='string' ? log.details_json : JSON.stringify(log.details_json) %></pre><% } %></div></article><% }) %></div><% } else { %><div class="empty-card"><h2>No matching events</h2><p>Try another action or record type.</p></div><% } %>
  <nav class="pagination" aria-label="Audit pages"><% if(page>1){ %><a class="button quiet" href="/admin/audit?q=<%= encodeURIComponent(query) %>&page=<%= page-1 %>">← Newer</a><% } %><span>Page <%= page %></span><% if(hasNext){ %><a class="button quiet" href="/admin/audit?q=<%= encodeURIComponent(query) %>&page=<%= page+1 %>">Older →</a><% } %></nav>
</section></main><%- include('partials/footer') %>
