<%- include('partials/header', { title: 'Admin review | HealthConnect Bharat' }) %>
<main class="dashboard-wrap"><section class="panel" id="admin-dashboard"><span class="eyebrow">Restricted operations</span><h1>Administrator review</h1><div class="stats-grid"><article><strong><%= stats.total_users %></strong><span>Total users</span></article><article><strong><%= stats.patients %></strong><span>Patients</span></article><article><strong><%= stats.doctors %></strong><span>Doctors</span></article><article><strong><%= stats.hospitals %></strong><span>Hospitals</span></article><article><strong><%= stats.pending_reviews %></strong><span>Pending verifications</span></article><article><strong><%= stats.upcoming_appointments %></strong><span>Upcoming appointments</span></article></div><a class="button quiet" href="/admin/audit">Search audit log →</a></section>
  <section class="panel workflow-panel" id="a-provider-applications"><h2>Provider applications</h2><% if(providers.length){ %><div class="workflow-list"><% providers.forEach((provider)=>{ %><article class="workflow-card"><div><h3><%= provider.name %> · <%= roles[provider.role] %></h3><p><%= provider.email %> · <%= provider.phone %></p><p><%= provider.organization||provider.specialization||'' %> · <%= provider.qualification||'' %></p><p>Registration: <%= provider.registration_number||'—' %> · <%= provider.registration_authority||'—' %></p><p><%= provider.practice_address||'' %> <%= provider.city||'' %>, <%= provider.state||'' %> <%= provider.postal_code||'' %></p><% if(provider.role==='hospital'){ %><p><strong>Hospital:</strong> <%= provider.hospital_name||'' %> · <%= provider.hospital_address||'' %> · Licence <%= provider.hospital_licence||'' %></p><p><strong>Departments:</strong> <%= provider.departments||'' %> · <strong>Services:</strong> <%= provider.services||'' %> · <strong>Facilities:</strong> <%= provider.facilities||'' %> · <%= provider.accessibility||'' %></p><p>Representative: <%= provider.representative_name||'' %></p><% } %><p>Status: <span class="status-pill"><%= provider.verification_status %></span><% if(provider.review_reason){ %> · <%= provider.review_reason %><% } %></p><small>Submitted <%= formatDateTime(provider.submitted_at) %></small><p class="fineprint">Email verification and submitted registration details are not proof of an active licence. Review supporting documents through your controlled process before approving.</p></div>
  <% if(provider.role==='doctor'){ %><p><% if(provider.latest_document_id){ %><a href="/providers/documents/<%= provider.latest_document_id %>/file">Download latest private verification document</a><% } else { %>No private verification document uploaded yet.<% } %></p><% } %><form method="post" action="/admin/providers/<%= provider.id %>/review" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Review reason<textarea name="reason" maxlength="1000" rows="3" placeholder="Required for rejection or correction request"></textarea></label><label>Decision<select name="status" required><option value="UNDER_REVIEW">Under review</option><option value="VERIFIED">Approve as manually reviewed</option><option value="NEEDS_CORRECTION">Request correction</option><option value="REJECTED">Reject application</option></select></label><button class="button primary">Save review</button></form></article><% }) %></div><% } else { %><div class="empty-card"><h3>No applications to review</h3><p>New provider applications appear here after email verification.</p></div><% } %></section>
  <section class="panel workflow-panel" id="a-affiliations"><h2>Hospital affiliation requests</h2><% if(affiliations.length){ %><div class="workflow-list"><% affiliations.forEach((item)=>{ %><article class="workflow-card"><div><h3><%= item.doctor_name %> · <%= item.hospital_name %></h3><p><%= item.doctor_email %></p><p>Status: <span class="status-pill"><%= item.status %></span></p></div><form method="post" action="/admin/affiliations/<%= item.id %>/review" class="action-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary" name="status" value="APPROVED">Approve affiliation</button><button class="button quiet" name="status" value="REJECTED">Reject</button></form></article><% }) %></div><% } else { %><p class="muted">No hospital affiliation requests are waiting for review.</p><% } %></section>
  <section class="panel workflow-panel" id="a-accounts"><h2>Accounts</h2><div class="workflow-list"><% users.forEach((account)=>{ %><article class="workflow-card"><div><strong><%= account.name %></strong><p><%= account.email %> · <%= roles[account.role] %> · <%= account.account_status %></p></div><% if(account.account_status==='suspended'){ %><form method="post" action="/admin/users/<%= account.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="active"><button class="button quiet">Restore</button></form><% } else { %><form method="post" action="/admin/users/<%= account.id %>/status" data-confirm="Suspend this account?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="suspended"><button class="button quiet">Suspend</button></form><% } %></article><% }) %></div></section>
</main><%- include('partials/footer') %>
