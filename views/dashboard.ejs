<%- include('partials/header', { title: 'My dashboard | HealthConnect Bharat' }) %>

<main class="dashboard-wrap <%= profileOnly ? 'profile-screen' : '' %> <%= sectionOnly ? `section-screen section-only-${sectionOnly}` : '' %>">
  <% const doctorApproved = user.role === 'doctor' && provider?.verification_status === 'VERIFIED' && profile.account_status === 'active'; %>
  <% if (user.role === 'patient') { %>
    <% const patientNextAppointment = appointments.find((item) => item.is_upcoming); const patientUnread = notifications.filter((item) => !item.read_at).length; %>
    <section class="panel patient-overview" id="patient-dashboard"><div><span class="eyebrow">Patient dashboard</span><h1>Your care overview</h1><p class="muted">Appointments, records and prescriptions in one place.</p></div><div class="doctor-stats"><article><span>Upcoming appointments</span><strong><%= appointments.filter((item)=>item.is_upcoming).length %></strong></article><article><span>Medical records</span><strong><%= records.length %></strong></article><article><span>Prescriptions</span><strong><%= prescriptions.length %></strong></article><article><span>Unread notifications</span><strong><%= patientUnread %></strong></article></div><div class="doctor-quick-actions"><a class="button quiet" href="/hospitals">Find a hospital</a><a class="button quiet" href="#patient-appointments">My appointments</a></div><div class="doctor-upcoming"><h2>Next appointment</h2><% if(patientNextAppointment){ %><p><strong><%= patientNextAppointment.doctor_name %></strong> · <%= patientNextAppointment.specialization||'Doctor' %> · <%= formatDateTime(patientNextAppointment.starts_at) %></p><p>Booking <%= patientNextAppointment.booking_reference %> · <span class="status-pill"><%= patientNextAppointment.status %></span></p><% } else { %><p class="muted">No upcoming appointments. Use Find a doctor in the main navigation to get started.</p><% } %></div></section>
    <section class="panel medical-chat-panel" id="patient-medical-assistant">
      <div class="section-heading"><div><span class="eyebrow">Patient health assistant</span><h2>Ask a health question</h2></div><span class="status-pill <%= medicalAiConfigured ? '' : 'pending' %>"><%= medicalAiConfigured ? 'AI configured' : 'Setup needed' %></span></div>
      <% if(!medicalAiConfigured){ %><p class="status-banner"><strong>AI service not connected yet.</strong> To enable answers, configure <code>MEDICAL_AI_BASE_URL</code>, <code>MEDICAL_AI_API_KEY</code> and <code>MEDICAL_AI_MODEL</code> in the server <code>.env</code> file, then restart.</p><% } %>
      <div class="medical-chat-log" data-medical-chat-log role="log" aria-live="polite" aria-label="Health assistant conversation"><div class="medical-chat-message assistant">Hi! You can ask general health questions, dictate a message, or attach a photo. I can share general information, but I cannot diagnose or replace a doctor.</div></div>
      <form class="medical-chat-form" data-medical-chat data-configured="<%= medicalAiConfigured ? 'true' : 'false' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="imageData" data-medical-image-data>
        <label class="medical-chat-question">Your question<textarea name="message" data-medical-message rows="3" maxlength="4000" placeholder="Describe what you would like to understand…"></textarea></label>
        <div class="medical-chat-attachment" data-medical-attachment hidden><img data-medical-preview alt="Selected medical image preview"><div><strong data-medical-filename></strong><button type="button" class="button quiet" data-remove-medical-image>Remove image</button></div></div>
        <input class="visually-hidden" type="file" accept="image/jpeg,image/png,image/webp" capture="environment" data-camera-input>
        <input class="visually-hidden" type="file" accept="image/jpeg,image/png,image/webp" data-gallery-input>
        <div class="medical-chat-tools"><label>Voice language<select data-voice-language><option value="hi-IN">Hindi / Hinglish</option><option value="en-IN">English (India)</option></select></label><button class="button quiet" type="button" data-start-voice>🎙 Speak</button><button class="button quiet" type="button" data-take-photo>📷 Take photo</button><button class="button quiet" type="button" data-choose-photo>🖼 Choose photo</button><button class="button primary" type="submit" data-send-medical>Send question</button></div>
        <p class="medical-chat-status muted" data-medical-status role="status"></p>
        <label class="medical-ai-consent"><input type="checkbox" name="aiConsent" value="yes" required><span>I understand my message, voice recording for transcription, or selected image will be sent to the AI service configured for this website. HealthConnect does not save this chat.</span></label>
      </form>
      <dialog class="medical-camera-dialog" data-camera-dialog aria-label="Take a medical photo"><div><h3>Take a photo</h3><video data-camera-video autoplay muted playsinline></video><p class="muted" data-camera-status role="status">Allow camera access to take a photo.</p><div class="proof-actions"><button class="button primary" type="button" data-capture-photo>Capture photo</button><button class="button quiet" type="button" data-close-camera>Cancel</button></div></div></dialog>
      <p class="fineprint">For general information only. Do not share emergency cases or use this chat to decide on medicines. For severe or rapidly worsening symptoms, seek urgent in-person care. Voice dictation may be processed by the browser's speech service.</p>
    </section>
  <% } %>
  <% if (user.role === 'doctor' && !doctorWorkspace) { %>
    <div class="status-banner"><strong>Doctor profile</strong><p>This page contains your professional and account details. Open Doctor home for appointments, availability, patient records and other approved practice tools.</p></div>
  <% } %>
  <% if (user.role === 'doctor' && doctorWorkspace) { %>
    <section class="panel doctor-overview" id="doctor-home">
      <div class="doctor-overview-head">
        <img src="<%= profile.profile_image_url || '/doctor-avatar.svg' %>" alt="Dr. <%= profile.name %>" class="doctor-overview-avatar">
        <div><span class="eyebrow">Doctor dashboard</span><h1>Dr. <%= profile.name %></h1><p><%= profile.specialization || 'Specialty not set' %> · <%= profile.qualification || 'Qualification not set' %></p></div>
        <span class="status-pill <%= doctorApproved ? '' : 'pending' %>"><%= provider?.verification_status || 'PENDING' %></span>
      </div>
      <div class="doctor-completion"><div><span>Profile completion</span><strong><%= doctorProfileCompletion %>%</strong></div><progress max="100" value="<%= doctorProfileCompletion %>"><%= doctorProfileCompletion %>%</progress><small>Complete your profile and submit accurate registration details for review.</small></div>
      <div class="doctor-stats"><article><span>Appointments today</span><strong><%= Number(doctorStats.today || 0) %></strong></article><article><span>Upcoming</span><strong><%= Number(doctorStats.upcoming || 0) %></strong></article><article><span>Total</span><strong><%= Number(doctorStats.total || 0) %></strong></article><article><span>Completed</span><strong><%= Number(doctorStats.completed || 0) %></strong></article><article><span>Pending requests</span><strong><%= Number(doctorStats.pending || 0) %></strong></article></div>
      <div class="doctor-upcoming"><h2>Next appointments</h2>
        <% if (doctorUpcoming.length) { %><div class="workflow-list"><% doctorUpcoming.forEach((item) => { %><article class="workflow-card"><div><strong><%= formatDateTime(item.starts_at) %></strong><p><%= item.consultation_type.replace('_',' ') %> · <%= item.location || 'Location to be confirmed' %> · <%= item.status %></p><small>Booking <%= item.booking_reference %></small></div></article><% }) %></div><% } else { %><p class="muted">No upcoming appointments right now.</p><% } %>
      </div>
      <div class="doctor-upcoming"><h2>Recent activity</h2><% if(doctorActivity.length){ %><ul class="doctor-activity-list"><% doctorActivity.forEach((activity)=>{ %><li><span><%= activity.action.replaceAll('.', ' ') %></span><small><%= formatDateTime(activity.created_at) %></small></li><% }) %></ul><% } else { %><p class="muted">Your appointment and profile activity will appear here.</p><% } %></div>
      <% if (doctorApproved && profile.account_status === 'active') { %><div class="doctor-quick-actions"><a class="button primary" href="#doctor-appointments">Manage appointments</a><a class="button quiet" href="#doctor-schedule">Set availability</a><a class="button quiet" href="#doctor-patients">View patients</a><a class="button quiet" href="#doctor-appointments">Create prescription</a><a class="button quiet" href="#doctor-records">View medical records</a></div><% } else { %><div class="status-banner"><strong>Doctor tools are locked until admin approval.</strong><p>Your profile and verification page are available while your documents are reviewed. Appointments, patient details, scheduling, messages and clinical records unlock after your account is approved and active.</p><a href="/provider/status">Complete or check verification →</a></div><% } %>
    </section>
    <section class="panel workflow-panel" id="doctor-clinic"><div class="section-heading"><div><span class="eyebrow">Practice location</span><h2>Hospital / clinic</h2></div></div><p><strong><%= profile.organization || 'Clinic or hospital not set' %></strong></p><p><%= provider?.practice_address || 'Add your practice address in Settings → Profile.' %> · <%= profile.city || 'City not set' %></p><h3>Affiliations</h3><% if(doctorAffiliations.length){ %><div class="workflow-list"><% doctorAffiliations.forEach((affiliation)=>{ %><article class="workflow-card"><strong><%= affiliation.registered_name %></strong><span class="status-pill"><%= affiliation.status %></span></article><% }) %></div><% } else { %><p class="muted">No hospital affiliation requests yet.</p><% } %><% if(doctorApproved && profile.account_status==='active' && doctorHospitals.length){ %><form method="post" action="/doctor/affiliations" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Request an affiliation<select name="hospitalId" required><option value="">Select a hospital</option><% doctorHospitals.forEach((hospital)=>{ %><option value="<%= hospital.id %>"><%= hospital.registered_name %></option><% }) %></select></label><button class="button quiet">Submit affiliation request</button></form><% } else if(!doctorApproved || profile.account_status!=='active'){ %><p class="muted">Affiliation tools unlock after administrator approval.</p><% } else { %><p class="muted">No hospital accounts are available for affiliation.</p><% } %></section>
    <section class="panel workflow-panel" id="doctor-online"><span class="eyebrow">Consultation</span><h2>Online consultation</h2>
      <% if(!doctorApproved){ %><p class="status-banner">Online consultation becomes available after your doctor account is verified and active.</p>
      <% } else if(videoConfigured){ %><p class="status-banner">Video service is configured. Manage your online availability, weekly hours and consultation requests here.</p><a class="button primary" href="/consultations">Open online consultations →</a>
      <% } else { %><p class="status-banner">Video setup is incomplete. Add PAYMENT_MODE=MOCK and valid LiveKit values to .env, then restart the server. You can still save your availability from the consultations page.</p><a class="button quiet" href="/consultations">Manage online availability →</a><% } %>
      <% const onlineVisits=appointments.filter((item)=>item.consultation_type==='online'); %><% if(onlineVisits.length){ %><div class="workflow-list"><% onlineVisits.forEach((item)=>{ %><article class="workflow-card"><div><strong><%= item.patient_name %> · <%= item.booking_reference %></strong><p><%= formatDateTime(item.starts_at) %> · <%= item.status %></p></div></article><% }) %></div><% } else { %><p>No online appointments have been booked.</p><% } %></section>
    <section class="panel workflow-panel" id="doctor-messages"><div class="section-heading"><div><span class="eyebrow">Appointment-linked</span><h2>Messages</h2></div></div><p class="muted">Messages are limited to your own appointments and their patients.</p><% if(doctorMessages.length){ %><div class="workflow-list"><% doctorMessages.forEach((message)=>{ %><article class="workflow-card"><div><strong><%= message.participant_name %> · Booking <%= message.booking_reference %></strong><p><%= message.message %></p><small><%= formatDateTime(message.created_at) %></small></div><% if(Number(message.recipient_id)===Number(user.id)&&!message.read_at){ %><form method="post" action="/messages/<%= message.id %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button quiet">Mark read</button></form><% } %></article><% }) %></div><% } else { %><p>No appointment messages yet.</p><% } %><% if(doctorApproved && appointments.some((item)=>['BOOKED','CONFIRMED','COMPLETED'].includes(item.status))){ %><form method="post" action="/doctor/messages" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Appointment<select name="appointmentId" required><% appointments.filter((item)=>['BOOKED','CONFIRMED','COMPLETED'].includes(item.status)).forEach((item)=>{ %><option value="<%= item.id %>"><%= item.patient_name %> · <%= item.booking_reference %></option><% }) %></select></label><label>Message<textarea name="message" maxlength="2000" required rows="3"></textarea></label><button class="button primary">Send appointment message</button></form><% } %></section>
    <section class="panel workflow-panel" id="doctor-payment-settings"><span class="eyebrow">Clinic appointment payments</span><h2>UPI payment details</h2><p class="muted">Patients see these details when they choose online UPI for a face-to-face visit. The payment flow is demo-only and does not verify bank transfers.</p>
      <% if(!doctorApproved){ %><div class="status-banner">UPI details can be saved after your doctor account is approved.</div><% } else { %>
      <form method="post" action="/doctor/payment-profile" class="form-stack" data-doctor-payment-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>UPI ID<input name="upiId" required maxlength="120" pattern="[A-Za-z0-9._-]{2,80}@[A-Za-z0-9.-]{2,40}" placeholder="doctor@bank" value="<%= doctorPaymentProfile?.upi_id || '' %>"></label><label>UPI QR code<input type="file" accept="image/jpeg,image/png,image/webp" data-doctor-qr-file><input type="hidden" name="qrImageData" data-doctor-qr-data><small>JPG, PNG or WebP, up to 5 MB. Upload a new image to update it.</small></label><img class="doctor-payment-qr" data-doctor-qr-preview src="<%= doctorPaymentProfile?.qr_image_url || '' %>" alt="Your saved UPI QR code" <%= doctorPaymentProfile?.qr_image_url ? '' : 'hidden' %>><button class="button primary" type="submit">Save UPI details</button></form><% } %>
    </section>
  <% } %>
  <% if (profileOnly || (user.role === 'doctor' && !doctorWorkspace)) { %><section class="panel profile-panel" <% if(user.role==='patient'){ %>id="patient-profile"<% } %>>
    <div class="dashboard-head">
      <div><span class="eyebrow"><%= roles[user.role] || 'My account' %></span><h1>Hello, <%= user.name %></h1><p class="muted">Your account and care activity.</p></div>
    </div>
    <% if (['doctor','patient'].includes(user.role)) { %>
      <form method="post" action="/profile/photo" class="doctor-photo-update form-stack" id="doctor-photo" data-change-save>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- include('partials/doctor-photo-picker', { photoUrl: profile.profile_image_url, avatarUrl: user.role === 'patient' ? '/patient-avatar.svg' : '/doctor-avatar.svg', idPrefix: 'dashboard-profile', heading: 'Update profile picture' }) %>
        <button class="button primary" type="submit" data-change-submit hidden>Save picture</button>
      </form>
    <% } %>
    <% if (provider) { %>
      <div class="status-banner" id="doctor-verification"><strong>Doctor verification: <%= provider.verification_status %></strong><p>Registration <%= profile.registration_number || 'not provided' %> · Authority <%= provider.registration_authority || 'not provided' %> · Qualification <%= profile.qualification || 'not provided' %></p><% if (provider.review_reason) { %><p>Reviewer feedback: <%= provider.review_reason %></p><% } %><% if(provider.verification_status==='PENDING'){ %><p>Your profile is hidden from patient search until an administrator verifies it.</p><% } %><a href="/provider/status">View documents and review history →</a></div>
    <% } %>
    <form method="post" action="<%= user.role === 'doctor' ? '/doctor/profile/change/request' : '/profile' %>" class="profile-edit form-stack" id="doctor-profile" data-change-save>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <h2><%= user.role === 'patient' ? 'My patient profile' : 'Doctor profile and professional details' %></h2>
      <div class="two-col">
        <label>Full name<input name="name" required minlength="2" maxlength="100" value="<%= profile.name || user.name %>"></label>
        <label>Email address<input type="email" value="<%= profile.email %>" readonly></label>
        <label>Phone<input name="phone" type="tel" required value="<%= profile.phone || '' %>"></label>
        <label>City<input name="city" maxlength="100" value="<%= profile.city || '' %>"></label>
        <% if (user.role === 'doctor') { %>
          <label>Medical specialty<select name="specialization" required><% doctorSpecialties.forEach((item) => { %><option value="<%= item %>" <%= profile.specialization === item ? 'selected' : '' %>><%= item %></option><% }) %></select></label>
          <label id="doctor-clinic">Clinic / hospital name<input name="organization" maxlength="180" value="<%= profile.organization || '' %>"></label>
          <label>Consultation fee (₹)<input type="number" name="consultationFee" min="0" max="100000" step="0.01" value="<%= profile.consultation_fee ?? '' %>" placeholder="Optional"></label>
          <label>Years of experience<input type="number" name="yearsExperience" min="0" max="70" step="1" value="<%= provider?.years_experience ?? '' %>"></label>
          <label>Practice / clinic address<input name="practiceAddress" maxlength="500" value="<%= provider?.practice_address || '' %>"></label>
          <label>State<input name="state" maxlength="100" value="<%= provider?.state || '' %>"></label>
          <label>About your practice<textarea name="bio" maxlength="2000" rows="4"><%= provider?.bio || '' %></textarea></label>
          <fieldset class="doctor-qualification-picker" data-qualification-selector>
            <legend>Medical qualifications <span>(choose 1–3)</span></legend>
            <div class="qualification-options"><% doctorQualifications.forEach((item) => { %><label><input type="checkbox" name="doctorQualifications" value="<%= item %>" <%= String(profile.qualification || '').split(' · ').includes(item) ? 'checked' : '' %>><span><%= item %></span></label><% }) %></div>
            <small data-qualification-message role="status">Choose up to three qualifications.</small>
          </fieldset>
          <label>Medical registration number<input name="registrationNumber" required maxlength="100" value="<%= profile.registration_number || '' %>"></label>
          <label>Issuing authority<input name="registrationAuthority" required maxlength="180" value="<%= provider?.registration_authority || '' %>"></label>
          <p class="status-banner">Any doctor profile change requires a code sent to your verified email. After confirmation, the profile is hidden from patient search and marked pending until an administrator approves it. Your DP can be updated separately.</p>
        <% } %>
      </div>
      <p class="muted">Account status: <strong><%= profile.account_status %></strong> · Email <strong><%= profile.email_verified ? 'verified' : 'not verified' %></strong><% if(user.role==='patient'){ %> · Your name, phone, city and profile picture are saved to your account.<% } %></p>
      <button class="button primary" type="submit" data-change-submit hidden><%= user.role === 'doctor' ? 'Verify email & request admin review' : 'Save profile' %></button>
    </form>
  </section><% } %>

  <% if (user.role === 'patient') { %>
    <section class="panel workflow-panel" id="patient-appointments"><div class="section-heading"><div><span class="eyebrow">Your care</span><h2>Appointments</h2></div></div>
      <% if (appointments.length) { %><div class="workflow-list">
        <% appointments.forEach((item) => { %><article class="workflow-card">
          <div class="appointment-doctor"><img class="doctor-avatar" src="<%= item.doctor_profile_image_url || '/doctor-avatar.svg' %>" alt="Photo of <%= item.doctor_name %>"><div><h3><%= item.doctor_name %></h3><p><%= item.specialization || 'Healthcare professional' %><% if(item.doctor_qualification){ %> · <%= item.doctor_qualification %><% } %></p><p><%= formatDateTime(item.starts_at) %></p><p>Booking <strong><%= item.booking_reference %></strong> · <span class="status-pill"><%= item.status %></span></p><p><strong>Appointment type:</strong> <%= item.consultation_type === 'online' ? 'Online consultation' : 'Face to face' %><% if(item.consultation_type === 'online' && !videoConfigured){ %> · Video setup is not configured<% } else if(item.consultation_type !== 'online'){ %> · <%= item.clinic_location || 'Clinic location to be confirmed' %><% } %></p><% if(item.consultation_type==='in_person'){ %><p><strong>Fee:</strong> ₹<%= Number(item.payment_amount||0).toFixed(2) %> · <strong>Payment:</strong> <%= item.payment_status==='CASH_DUE'?'Cash due at clinic':item.payment_status==='PAID'?(item.payment_method==='UPI'?'Mock UPI payment recorded':'Paid'):item.payment_status==='PENDING'?'UPI payment pending':item.payment_status %><% if(item.payment_method==='UPI'&&item.mock_payment_reference){ %> · Demo ref <%= item.mock_payment_reference %><% } %></p><% } %></div></div>
          <% if(item.status==='CONFIRMED'&&item.consultation_type==='in_person'){ %><div class="action-stack"><a class="button primary" href="/appointments/<%= item.id %>/confirmation">View appointment proof</a><a class="button quiet" href="/appointments/<%= item.id %>/proof.pdf" download>Download proof PDF</a></div><% } else if(item.status==='BOOKED'&&item.payment_method==='UPI'&&item.payment_status==='PENDING'){ %><a class="button primary" href="/appointments/<%= item.id %>/pay">View UPI &amp; complete demo payment</a><% } %>
          <% if (['BOOKED','CONFIRMED'].includes(item.status)) { %><div class="action-stack"><form method="post" action="/appointments/<%= item.id %>/cancel" data-confirm="Cancel this appointment?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button quiet" type="submit">Cancel</button><small>Cancel at least <%= cancellationCutoffHours %> hours before.</small></form><% const ownDoctorSlots=patientAvailableSlots.filter((slot)=>Number(slot.doctor_id)===Number(item.doctor_id)); if(ownDoctorSlots.length&&!(item.payment_method==='UPI'&&item.payment_status==='PENDING')){ %><form method="post" action="/appointments/<%= item.id %>/reschedule" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Reschedule with this doctor<select name="availabilityId" required><option value="">Choose a new time</option><% ownDoctorSlots.forEach((slot)=>{ %><option value="<%= slot.id %>"><%= formatDateTime(slot.starts_at) %></option><% }) %></select></label><button class="button quiet">Reschedule</button><small>Rescheduling stays confirmed and uses this appointment’s payment method.</small></form><% } %></div><% } %>
        </article><% }) %>
      </div><% } else { %><div class="empty-card"><h3>No appointments yet</h3><p>Use Find a doctor in the main navigation to search the approved directory and request a visit.</p></div><% } %>
    </section>

    <section class="panel workflow-panel" id="patient-online"><div class="section-heading"><div><span class="eyebrow">Consultation status</span><h2>Online consultations</h2></div></div><% const onlinePatientVisits=appointments.filter((item)=>item.consultation_type==='online'); %><% if(onlinePatientVisits.length){ %><p class="status-banner">Video consultation is not configured. Your appointment request and booking details are listed here.</p><div class="workflow-list"><% onlinePatientVisits.forEach((item)=>{ %><article class="workflow-card"><div><strong><%= item.doctor_name %></strong><p><%= formatDateTime(item.starts_at) %> · <%= item.status %> · Ref <%= item.booking_reference %></p></div></article><% }) %></div><% } else { %><p class="muted">No online appointments. Online video service is not configured yet.</p><% } %></section>    <section class="panel workflow-panel" id="patient-care-messages"><div class="section-heading"><div><span class="eyebrow">Appointment-linked</span><h2>Messages with your doctors</h2></div></div><% if(patientMessages.length){ %><div class="workflow-list"><% patientMessages.forEach((message)=>{ %><article class="workflow-card"><div><strong><%= message.participant_name %> · Booking <%= message.booking_reference %></strong><p><span class="status-pill"><%= Number(message.sender_id)===Number(user.id)?'You sent':'Doctor sent' %></span> <%= message.message %></p><small><%= formatDateTime(message.created_at) %></small></div><% if(Number(message.recipient_id)===Number(user.id)&&!message.read_at){ %><form method="post" action="/messages/<%= message.id %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button quiet">Mark read</button></form><% } %></article><% }) %></div><% } else { %><p>No appointment messages yet.</p><% } %><% if(appointments.some((item)=>['BOOKED','CONFIRMED','COMPLETED'].includes(item.status))){ %><form method="post" action="/patient/messages" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Appointment<select name="appointmentId" required><% appointments.filter((item)=>['BOOKED','CONFIRMED','COMPLETED'].includes(item.status)).forEach((item)=>{ %><option value="<%= item.id %>"><%= item.doctor_name %> · <%= item.booking_reference %></option><% }) %></select></label><label>Message<textarea name="message" maxlength="2000" required rows="3"></textarea></label><button class="button primary">Send message</button></form><% } %></section>

    <section class="panel workflow-panel" id="patient-records"><div class="section-heading"><div><span class="eyebrow">Private to your account</span><h2>Medical records</h2></div></div>
      <% if (records.length) { %><div class="workflow-list"><% records.forEach((record) => { %><article class="workflow-card"><div><h3><%= record.title %></h3><p><%= formatDateTime(record.created_at) %></p><p class="record-notes"><%= record.notes || '' %></p><% if(record.private_file_key){ %><a href="/medical-records/<%= record.id %>/file">Download private attachment</a><% } %></div></article><% }) %></div><% } else { %><div class="empty-card"><h3>No medical records</h3><p>Records added by a doctor for your care will appear here.</p></div><% } %>
    </section>

    <section class="panel workflow-panel" id="patient-prescriptions"><div class="section-heading"><div><span class="eyebrow">Clinician-issued</span><h2>Prescriptions</h2></div></div>
      <% if (prescriptions.length) { %><div class="workflow-list"><% prescriptions.forEach((prescription) => { %><article class="workflow-card"><div><h3>Prescription from <%= prescription.doctor_name %></h3><p><%= prescription.specialization || 'Doctor' %> · <%= formatDateTime(prescription.issued_at) %></p><a href="/prescriptions/<%= prescription.id %>">View prescription →</a></div></article><% }) %></div><% } else { %><div class="empty-card"><h3>No prescriptions</h3><p>Prescriptions from your doctor will be listed here.</p></div><% } %>
    </section>
  <% } %>

  <% if (user.role === 'doctor' && doctorWorkspace) { %>
    <% if (doctorApproved) { %>
      <section class="panel workflow-panel" id="doctor-schedule"><div class="section-heading"><div><span class="eyebrow">Scheduling</span><h2>Weekly appointment schedule</h2></div></div>
        <h3>Weekly working hours</h3><p class="muted">Saved hours appear on the patient-facing doctor listing and profile. Available appointment times are created for the next 7 days; existing bookings are preserved. Example: select a day, set 09:00–17:00, choose 30 minutes, and leave both break fields empty if you do not need a break.</p>
        <% if (weeklySchedule.length) { %><div class="doctor-upcoming"><h3>Saved schedule</h3><div class="workflow-list"><% const clinicDays=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday']; weeklySchedule.forEach((item)=>{ %><article class="workflow-card"><strong><%= clinicDays[Number(item.weekday)] %></strong><span><%= String(item.starts_at).slice(0,5) %>–<%= String(item.ends_at).slice(0,5) %> · <%= item.appointment_minutes %>-minute appointments</span></article><% }) %></div></div><% } %>
        <details id="doctor-schedule-editor" class="schedule-editor" <%= weeklySchedule.length ? '' : 'open' %>><summary class="button quiet"><%= weeklySchedule.length ? 'Edit schedule' : 'Set weekly schedule' %></summary><form method="post" action="/doctor/schedule" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><fieldset><legend>Working days</legend><div class="qualification-options"><% ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'].forEach((day,index)=>{ %><label><input type="checkbox" name="weekdays" value="<%= index %>" <%= weeklySchedule.some((item)=>Number(item.weekday)===index) ? 'checked' : '' %>><span><%= day %></span></label><% }) %></div></fieldset><div class="two-col"><label>Start time<input type="time" name="scheduleStart" value="<%= weeklySchedule[0]?.starts_at ? String(weeklySchedule[0].starts_at).slice(0,5) : '' %>" required></label><label>End time<input type="time" name="scheduleEnd" value="<%= weeklySchedule[0]?.ends_at ? String(weeklySchedule[0].ends_at).slice(0,5) : '' %>" required></label><label>Slot duration<select name="appointmentMinutes"><% [15,30,45,60].forEach((minutes)=>{ %><option value="<%= minutes %>" <%= Number(weeklySchedule[0]?.appointment_minutes || 30)===minutes ? 'selected' : '' %>><%= minutes %> minutes</option><% }) %></select></label><label>Break starts<input type="time" name="breakStart" value="<%= weeklySchedule[0]?.break_starts_at ? String(weeklySchedule[0].break_starts_at).slice(0,5) : '' %>"></label><label>Break ends<input type="time" name="breakEnd" value="<%= weeklySchedule[0]?.break_ends_at ? String(weeklySchedule[0].break_ends_at).slice(0,5) : '' %>"></label><label>Clinic location<input name="location" maxlength="300" value="<%= profile.organization || '' %>"></label></div><button class="button primary">Save schedule</button></form></details>
        <form method="post" action="/doctor/leave" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h3>Set a leave / unavailable date</h3><div class="two-col"><label>Date<input type="date" name="unavailableDate" required></label><label>Reason (optional)<input name="reason" maxlength="180"></label></div><button class="button quiet">Block this date</button></form>
        <% if (unavailableDates.length) { %><p class="muted">Upcoming unavailable dates: <% unavailableDates.forEach((leave,index)=>{ %><%= index ? ', ' : '' %><%= String(leave.unavailable_date).slice(0,10) %><% if(leave.reason){ %> (<%= leave.reason %>)<% } %><% }) %></p><% } %>
        <form method="post" action="/doctor/availability" class="form-stack" data-utc-datetime><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="two-col"><label>Starts at<input type="datetime-local" name="startsAt" required></label><label>Ends at<input type="datetime-local" name="endsAt" required></label><label>Consultation type<select name="consultationType"><option value="in_person">Face to face</option><option value="online" disabled>Online (not configured)</option></select></label><label>Clinic / meeting location<input name="location" maxlength="300" placeholder="Clinic address"></label></div><button class="button primary">Add availability</button></form>
        <% if (availability.length) { %><h3>Calendar: available time slots (India time)</h3><div class="appointment-filters" role="group"><button type="button" class="active" data-calendar-filter="all">Month</button><button type="button" data-calendar-filter="week">Week</button><button type="button" data-calendar-filter="day">Day</button></div><label>Choose calendar date<input type="date" data-calendar-date></label><div class="workflow-list"><% availability.forEach((slot) => { %><article class="workflow-card" data-calendar-slot data-slot-date="<%= new Date(new Date(slot.starts_at instanceof Date ? slot.starts_at.toISOString() : `${String(slot.starts_at).replace(' ','T')}Z`).getTime()+330*60000).toISOString().slice(0,10) %>"><div><strong><%= formatDateTime(slot.starts_at) %></strong><p><%= slot.consultation_type.replace('_',' ') %> · <%= slot.location || 'Clinic location to be confirmed' %> · <%= slot.slot_status %></p></div><% if (slot.slot_status === 'AVAILABLE') { %><form method="post" action="/doctor/availability/<%= slot.id %>/block"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button quiet">Block time</button></form><% } %></article><% }) %></div><% } %>
      </section>
    <% } %>
    <section class="panel workflow-panel" id="doctor-appointments"><div class="section-heading"><div><span class="eyebrow">Your practice</span><h2>Appointments</h2></div></div>
      <% if (!doctorApproved) { %><div class="status-banner"><strong>Appointment actions are locked during review.</strong><p>Confirming requests and adding clinical records or prescriptions will be available after your professional details are verified.</p><a href="/provider/status">View verification status →</a></div><% } %>
      <div class="appointment-filters" role="group" aria-label="Filter appointments"><button type="button" class="active" data-appointment-filter="all">All</button><button type="button" data-appointment-filter="BOOKED">Pending</button><button type="button" data-appointment-filter="CONFIRMED">Confirmed</button><button type="button" data-appointment-filter="today">Today</button><button type="button" data-appointment-filter="upcoming">Upcoming</button><button type="button" data-appointment-filter="COMPLETED">Completed</button><button type="button" data-appointment-filter="closed">Cancelled / rejected</button></div>
      <% if (appointments.length) { %><div class="workflow-list"><% appointments.forEach((item) => { %><article class="workflow-card" data-doctor-appointment data-status="<%= item.status %>" data-is-today="<%= item.is_today ? 'true' : 'false' %>" data-is-upcoming="<%= item.is_upcoming ? 'true' : 'false' %>"><div class="appointment-doctor"><img class="doctor-avatar patient-list-avatar" src="<%= item.patient_profile_image_url || '/patient-avatar.svg' %>" alt="Photo of <%= item.patient_name %>"><div><h3><%= item.patient_name %></h3><p><%= formatDateTime(item.starts_at) %> · <%= item.consultation_type.replace('_',' ') %> · <%= item.clinic_location || 'Clinic location to be confirmed' %></p><p>Booking <%= item.booking_reference %> · <span class="status-pill"><%= item.status %></span></p><p><%= item.reason %></p></div></div>
        <% if (item.status==='BOOKED' && item.payment_method==='UPI' && item.payment_status==='PENDING') { %><p class="status-banner"><strong>Awaiting patient demo payment.</strong> The appointment confirms when the patient completes the mock UPI step.</p><% } else if (['BOOKED','CONFIRMED'].includes(item.status) && doctorApproved) { %><div class="action-stack"><% if(item.status==='BOOKED'){ %><form method="post" action="/doctor/appointments/<%= item.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="CONFIRMED"><button class="button primary">Confirm</button></form><form method="post" action="/doctor/appointments/<%= item.id %>/status" data-confirm="Reject this request?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="REJECTED"><button class="button quiet">Reject</button></form><% } else { %><form method="post" action="/doctor/appointments/<%= item.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="COMPLETED"><button class="button primary">Mark complete</button></form><form method="post" action="/doctor/appointments/<%= item.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="NO_SHOW"><button class="button quiet">No show</button></form><% } %><form method="post" action="/doctor/appointments/<%= item.id %>/status" data-confirm="Cancel this appointment? The patient will be notified."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="CANCELLED"><button class="button quiet">Cancel appointment</button></form></div><% } %>
        <% if(item.status==='CONFIRMED' && doctorApproved){ %><form method="post" action="/doctor/appointments/<%= item.id %>/request-reschedule" data-confirm="Ask the patient to contact you to reschedule this appointment?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button quiet">Request reschedule</button></form><% } %>
        <% if ((item.status === 'CONFIRMED' || item.status === 'COMPLETED') && doctorApproved) { %><details><summary>Add clinical information</summary><form method="post" action="/doctor/appointments/<%= item.id %>/records" class="form-stack" data-private-upload><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Record title<input name="title" required maxlength="180"></label><label>Care note<textarea name="notes" maxlength="10000" rows="3"></textarea></label><label>Attach a PDF, JPG, PNG or WebP file (maximum 5 MB)<input type="file" accept="application/pdf,image/jpeg,image/png,image/webp" data-private-file><input type="hidden" name="recordFileData" data-private-file-data></label><button class="button quiet">Save patient record</button></form><form method="post" action="/doctor/appointments/<%= item.id %>/prescriptions" class="form-stack" data-medicine-list><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h3>New prescription</h3><div data-medicine-rows><div class="medicine-entry"><label>Medicine name<input name="medicineName" maxlength="160" required></label><div class="two-col"><label>Dosage<input name="dosage" maxlength="100" placeholder="e.g. as directed"></label><label>Frequency<input name="frequency" maxlength="100" placeholder="e.g. as directed"></label><label>Duration<input name="duration" maxlength="100" placeholder="e.g. as directed"></label><label>Instructions<input name="medicineInstructions" maxlength="300"></label></div></div></div><template data-medicine-template><div class="medicine-entry"><button type="button" class="button quiet" data-remove-medicine>Remove this medicine</button><label>Medicine name<input name="medicineName" maxlength="160"></label><div class="two-col"><label>Dosage<input name="dosage" maxlength="100" placeholder="e.g. as directed"></label><label>Frequency<input name="frequency" maxlength="100" placeholder="e.g. as directed"></label><label>Duration<input name="duration" maxlength="100" placeholder="e.g. as directed"></label><label>Instructions<input name="medicineInstructions" maxlength="300"></label></div></div></template><button type="button" class="button quiet" data-add-medicine>+ Add another medicine</button><label>Additional notes<textarea name="additionalNotes" maxlength="5000" rows="2"></textarea></label><button class="button quiet">Issue prescription</button></form></details><% } %>
      </article><% }) %></div><% } else { %><div class="empty-card"><h3>No appointments</h3><p>Patient appointment requests will appear here.</p></div><% } %>
    </section>
    <section class="panel workflow-panel" id="doctor-patients">
      <div class="section-heading"><div><span class="eyebrow">Appointment relationships only</span><h2>Patients</h2></div></div>
      <p class="muted">This list includes only people who have an appointment with you. Medical notes below are limited to records you created for your own appointments.</p>
      <% if (!doctorApproved) { %><div class="empty-card"><h3>Patient list is locked during review</h3><p>Associated patient details become available after your doctor profile is verified.</p></div><% } else if (doctorPatients.length) { %><label>Search your patients<input type="search" data-patient-search placeholder="Search by patient name"></label><div class="workflow-list"><% doctorPatients.forEach((patient) => { %><article class="workflow-card" data-doctor-patient data-patient-name="<%= patient.name.toLowerCase() %>"><div class="appointment-doctor"><img class="doctor-avatar patient-list-avatar" src="<%= patient.profile_image_url || '/patient-avatar.svg' %>" alt="Photo of <%= patient.name %>"><div><h3><%= patient.name %></h3><p><%= patient.city || 'City not provided' %></p><small><%= patient.appointment_count %> appointment(s) · Last appointment <%= formatDateTime(patient.last_appointment) %></small></div></div></article><% }) %></div><% } else { %><div class="empty-card"><h3>No associated patients yet</h3><p>Patients appear after an appointment request is made with you.</p></div><% } %>
    </section>
    <section class="panel workflow-panel" id="doctor-records">
      <div class="section-heading"><div><span class="eyebrow">Records you authored</span><h2>Medical records</h2></div></div>
      <% if (!doctorApproved) { %><div class="empty-card"><h3>Records are locked during review</h3><p>Authorized clinical records become available after your doctor profile is verified.</p></div><% } else if (doctorRecords.length) { %><div class="workflow-list"><% doctorRecords.forEach((record) => { %><article class="workflow-card"><div><h3><%= record.title %> · <%= record.patient_name %></h3><p>Appointment #<%= record.appointment_id %> · <%= formatDateTime(record.created_at) %></p><p class="record-notes"><%= record.notes || 'No note text.' %></p><% if(record.private_file_key){ %><a href="/medical-records/<%= record.id %>/file">Download private attachment</a><% } %></div></article><% }) %></div><% } else { %><div class="empty-card"><h3>No medical records yet</h3><p>Records you create for confirmed or completed appointments will appear here.</p></div><% } %>
    </section>
    <section class="panel workflow-panel" id="doctor-prescriptions"><div class="section-heading"><div><span class="eyebrow">Clinical record history</span><h2>Issued prescriptions</h2></div></div><% if(!doctorApproved){ %><div class="empty-card"><h3>Prescription history is locked during review</h3><p>It becomes available after your doctor profile is verified.</p></div><% } else if(doctorPrescriptions.length){ %><div class="workflow-list"><% doctorPrescriptions.forEach((item)=>{ %><article class="workflow-card"><div><strong><%= item.patient_name %></strong><p><%= formatDateTime(item.issued_at) %> · <% if(item.amended_from){ %>Amends #<%= item.amended_from %><% } else { %>Original version<% } %></p><details><summary>View prescription</summary><p class="record-notes"><%= item.prescription_text %></p><% if(item.medicines?.length){ %><ul><% item.medicines.forEach((medicine)=>{ %><li><strong><%= medicine.name %></strong> · <%= medicine.dosage || 'Dosage not specified' %> · <%= medicine.frequency || 'Frequency not specified' %> · <%= medicine.duration || 'Duration not specified' %><% if(medicine.instructions){ %> · <%= medicine.instructions %><% } %></li><% }) %></ul><% } %><% if(item.additional_notes){ %><p><%= item.additional_notes %></p><% } %></details><a href="/prescriptions/<%= item.id %>" target="_blank" rel="noopener">Print-friendly prescription →</a><form method="post" action="/doctor/prescriptions/<%= item.id %>/amend" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>New prescription version<textarea name="prescription" required maxlength="20000" rows="3"></textarea></label><button class="button quiet">Save as amendment</button></form></div></article><% }) %></div><% } else { %><div class="empty-card"><p>Prescriptions you issue for confirmed or completed appointments appear here.</p></div><% } %></section>
  <% } %>


  <% if ((user.role === 'doctor' && doctorWorkspace) || user.role === 'patient') { %><section class="panel workflow-panel" id="doctor-notifications"><div class="section-heading"><div><span class="eyebrow">Updates</span><h2>Notifications</h2></div><% if(user.role==='doctor' && notifications.some((item)=>!item.read_at)){ %><form method="post" action="/notifications/read-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button quiet">Mark all read</button></form><% } %></div><% if (notifications.length) { %><div class="workflow-list"><% notifications.forEach((note) => { %><article class="workflow-card"><div><h3><%= note.title %> <% if (!note.read_at) { %><span class="status-pill">New</span><% } %></h3><p><%= note.message %></p><small><%= formatDateTime(note.created_at) %></small></div><% if (!note.read_at) { %><form method="post" action="/notifications/<%= note.id %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button quiet">Mark read</button></form><% } %></article><% }) %></div><% } else { %><div class="empty-card"><h3>You're all caught up</h3><p>Appointment and verification updates will appear here.</p></div><% } %></section><% } %>
</main>

<% if(user.role==='patient'){ %><script src="/patient-medical-assistant.js?v=20261006-live-voice-v2" defer></script><% } %>
<script src="/doctor-payment-settings.js" defer></script>
<%- include('partials/footer') %>
