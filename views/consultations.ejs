<%- include('partials/header', { title: 'Online consultations | HealthConnect Bharat' }) %>
<main class="dashboard-wrap consultation-page">
  <section class="panel"><span class="eyebrow"><%= pageRole==='doctor'?'Doctor workspace':'Patient care' %></span><h1>Online consultations</h1>
    <% if(!config){ %><div class="status-banner"><strong>Video setup required</strong><p>Set PAYMENT_MODE=MOCK and configure LiveKit URL, API key, and API secret in your local .env file to enable real browser video calls. Demo payments never process real money.</p></div><% } %>
    <% if(pageRole==='doctor'){ %>
      <% if(!verified){ %><div class="status-banner"><strong>Doctor verification required</strong><p>Only an active, administrator-verified doctor can offer online consultations.</p><a href="/provider/status">Review verification →</a></div><% } else { %>
      <% if(availabilitySaved){ %><p class="status-banner" role="status">Online consultation availability saved successfully.</p><% } %>
      <form id="online-availability" method="post" action="/doctor/consultations/availability" class="consult-setting" data-editable-settings><input type="hidden" name="_csrf" value="<%= csrfToken %>"><fieldset class="consult-setting-fields" data-editable-fields <%= hasAvailabilitySettings&&!editAvailability?'disabled':'' %>><label class="check-label"><input type="checkbox" name="enabled" value="1" <%= onlineEnabled?'checked':'' %>> Accept online consultation requests</label></fieldset><div class="action-stack"><a class="button quiet" data-edit-settings href="/consultations?edit=availability#online-availability" <%= hasAvailabilitySettings?'':'hidden' %>>Edit request status</a><button class="button primary" type="submit" data-save-settings <%= hasAvailabilitySettings&&!editAvailability?'hidden':'' %>>Save status</button></div></form>
      <% if(!adminOnlineEnabled){ %><p class="status-banner">The administrator currently has online consultations disabled. Turning on your own availability will not show a patient request button until the administrator re-enables the service.</p><% } else if(!onlineEnabled){ %><p class="status-banner">Admin has allowed online consultations. Patients can book your published appointment windows after you enable availability and save your weekly schedule.</p><% } else { %><p class="status-banner">Your online consultations are enabled. Patients can book available start times from your doctor profile; calls stay active until you end them.</p><% } %>
      <% if(!config){ %><p class="muted">You can save your availability now. Patients can book after LiveKit video setup is complete and the admin has enabled online consultations.</p><% } %>
      <% if (scheduleSaved) { %><p class="status-banner" role="status">Weekly online schedule saved. Patients can book start times inside these windows.</p><% } %>
      <form id="online-schedule-editor" method="post" action="/doctor/consultations/schedule" class="online-schedule" data-editable-settings><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2><%= hasSavedSchedule?'Your weekly online schedule':'Set weekly online schedule' %></h2><p class="fineprint">Turn on the days you accept online appointments. Set up to two availability windows for each day; patients choose 30-minute start times within them. Calls do not end automatically.</p><fieldset class="consult-setting-fields" data-editable-fields <%= hasSavedSchedule&&!editSchedule?'disabled':'' %>><% ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'].forEach((day,index)=>{ const daySchedule=onlineSchedule.find(item=>Number(item.weekday)===index); %><div class="online-schedule-row"><label class="check-label"><input type="checkbox" name="day_<%= index %>" value="1" <%= daySchedule?.enabled?'checked':'' %>><%= day %></label><label>Window 1 from<input type="time" name="start_<%= index %>" value="<%= daySchedule?.starts_at||'09:00' %>"></label><label>Until<input type="time" name="end_<%= index %>" value="<%= daySchedule?.ends_at||'10:00' %>"></label><label>Window 2 from<input type="time" name="second_start_<%= index %>" value="<%= daySchedule?.second_starts_at||'15:00' %>"></label><label>Until<input type="time" name="second_end_<%= index %>" value="<%= daySchedule?.second_ends_at||'16:00' %>"></label></div><% }) %></fieldset><div class="action-stack"><a class="button quiet" data-edit-settings href="/consultations?edit=schedule#online-schedule-editor" <%= hasSavedSchedule?'':'hidden' %>>Edit availability</a><button class="button primary" type="submit" data-save-settings <%= hasSavedSchedule&&!editSchedule?'hidden':'' %>>Save availability</button></div></form>
      <section class="doctor-earnings"><h2>My earnings</h2><p><strong>₹<%= Number(earnings.earnings).toFixed(2) %></strong> successful demo payments</p><p><%= earnings.total_count %> consultations · <%= Math.floor(Number(earnings.total_seconds)/60) %> min total call time · ₹<%= Number(earnings.pending_earnings).toFixed(2) %> pending demo payments · <%= earnings.completed_count %> completed</p></section>
    <% } %><% } %>
  </section>
  <section class="panel workflow-panel"><h2><%= pageRole==='doctor'?'Requests and sessions':'Your consultation history' %></h2>
    <% if(consultations.length){ %><div class="workflow-list"><% consultations.forEach((item)=>{ const otherName=pageRole==='doctor'?item.patient_name:item.doctor_name; const otherPhoto=pageRole==='doctor'?item.patient_photo:item.doctor_photo; %>
      <article class="workflow-card consultation-list-card"><div class="appointment-doctor"><img class="doctor-avatar" src="<%= otherPhoto || (pageRole==='doctor'?'/patient-avatar.svg':'/doctor-avatar.svg') %>" alt=""><div><h3><%= otherName %></h3><p><strong>Appointment type: Online consultation</strong> · <span class="status-pill"><%= item.status %></span></p><p><%= item.specialization || 'Online consultation' %></p><% if(item.scheduledAtLabel){ %><p><strong>Appointment:</strong> <%= item.scheduledAtLabel %> India time</p><% } %><small><%= formatDateTime(item.requested_at) %> · <%= Math.floor(Number(item.actual_seconds)/60) %> min <%= Number(item.actual_seconds)%60 %> sec · ₹<%= Number(item.rate_per_minute).toFixed(2) %>/minute · ₹<%= Number(item.total_amount).toFixed(2) %></small><p>Payment: <%= item.demo_payment_status||item.payment_status %><% if(item.transaction_id){ %> · <%= item.transaction_id %><% } %></p></div></div><a class="button quiet" href="/consultations/<%= item.public_id %>"><%= item.status==='ACCEPTED'?'Open scheduled call':'Open consultation' %></a></article>
    <% }) %></div><% } else { %><div class="empty-card"><h3>No online consultations yet</h3><p><%= pageRole==='doctor'?'Requests from patients will appear here.':'Visit a verified doctor profile and choose online consultation to start.' %></p></div><% } %>
  </section>
</main>
<%- include('partials/footer') %>
