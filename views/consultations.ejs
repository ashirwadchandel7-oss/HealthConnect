<%- include('partials/header', { title: 'Online consultations | HealthConnect Bharat' }) %>
<main class="dashboard-wrap consultation-page">
  <section class="panel"><span class="eyebrow"><%= pageRole==='doctor'?'Doctor workspace':'Patient care' %></span><h1>Online consultations</h1>
    <% if(!config){ %><div class="status-banner"><strong>Video setup required</strong><p>Set PAYMENT_MODE=MOCK and configure LiveKit URL, API key, and API secret in your local .env file to enable real browser video calls. Demo payments never process real money.</p></div><% } %>
    <% if(pageRole==='doctor'){ %>
      <% if(!verified){ %><div class="status-banner"><strong>Doctor verification required</strong><p>Only an active, administrator-verified doctor can offer online consultations.</p><a href="/provider/status">Review verification →</a></div><% } else { %>
      <% if(availabilitySaved){ %><p class="status-banner" role="status">Online consultation availability saved successfully.</p><% } %>
      <form id="online-availability" method="post" action="/doctor/consultations/availability" class="consult-setting" data-editable-settings><input type="hidden" name="_csrf" value="<%= csrfToken %>"><fieldset class="consult-setting-fields" data-editable-fields <%= hasAvailabilitySettings?'disabled':'' %>><label class="check-label"><input type="checkbox" name="enabled" value="1" <%= onlineEnabled?'checked':'' %>> Accept online consultation requests</label></fieldset><div class="action-stack"><button class="button quiet" type="button" data-edit-settings <%= hasAvailabilitySettings?'':'hidden' %>>Edit availability</button><button class="button primary" type="submit" data-save-settings <%= hasAvailabilitySettings?'hidden':'' %>>Save availability</button></div></form>
      <% if(!adminOnlineEnabled){ %><p class="status-banner">The administrator currently has online consultations disabled. Turning on your own availability will not show a patient request button until the administrator re-enables the service.</p><% } else if(!onlineEnabled){ %><p class="status-banner">Admin has allowed online consultations. Your patient-side request button will appear after you enable “Accept online consultation requests” and save availability above.</p><% } else { %><p class="status-banner">Your online requests are enabled. Patients can send a request from your doctor profile; you can accept it and set the appointment time below in Requests and sessions.</p><% } %>
      <% if(!config){ %><p class="muted">You can save your availability now. Patients can book after LiveKit video setup is complete and the admin has enabled online consultations.</p><% } %>
      <% if (scheduleSaved) { %><p class="status-banner" role="status">Weekly online schedule saved. These hours are stored and are used to show when patients can request consultations.</p><% } %>
      <form id="online-schedule-editor" method="post" action="/doctor/consultations/schedule" class="online-schedule" data-editable-settings><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2><%= hasSavedSchedule?'Your weekly online schedule':'Set weekly online schedule' %></h2><p class="fineprint">Choose the days and hours when patients may request a video consultation. With no saved hours, your availability toggle applies all day.</p><fieldset class="consult-setting-fields" data-editable-fields <%= hasSavedSchedule?'disabled':'' %>><% ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'].forEach((day,index)=>{ %><div class="online-schedule-row"><label class="check-label"><input type="checkbox" name="day_<%= index %>" value="1" <%= onlineSchedule.find(item=>Number(item.weekday)===index)?.enabled?'checked':'' %>><%= day %></label><label>From<input type="time" name="start_<%= index %>" value="<%= onlineSchedule.find(item=>Number(item.weekday)===index)?.starts_at||'09:00' %>"></label><label>Until<input type="time" name="end_<%= index %>" value="<%= onlineSchedule.find(item=>Number(item.weekday)===index)?.ends_at||'17:00' %>"></label></div><% }) %></fieldset><div class="action-stack"><button class="button quiet" type="button" data-edit-settings <%= hasSavedSchedule?'':'hidden' %>>Edit schedule</button><button class="button primary" type="submit" data-save-settings <%= hasSavedSchedule?'hidden':'' %>>Save schedule</button></div></form>
      <section class="doctor-earnings"><h2>My earnings</h2><p><strong>₹<%= Number(earnings.earnings).toFixed(2) %></strong> successful demo payments</p><p><%= earnings.total_count %> consultations · <%= Math.floor(Number(earnings.total_seconds)/60) %> min total call time · ₹<%= Number(earnings.pending_earnings).toFixed(2) %> pending demo payments · <%= earnings.completed_count %> completed</p></section>
    <% } %><% } %>
  </section>
  <section class="panel workflow-panel"><h2><%= pageRole==='doctor'?'Requests and sessions':'Your consultation history' %></h2>
    <% if(consultations.length){ %><div class="workflow-list"><% consultations.forEach((item)=>{ const otherName=pageRole==='doctor'?item.patient_name:item.doctor_name; const otherPhoto=pageRole==='doctor'?item.patient_photo:item.doctor_photo; %>
      <article class="workflow-card consultation-list-card"><div class="appointment-doctor"><img class="doctor-avatar" src="<%= otherPhoto || (pageRole==='doctor'?'/patient-avatar.svg':'/doctor-avatar.svg') %>" alt=""><div><h3><%= otherName %></h3><p><strong>Appointment type: Online consultation</strong> · <span class="status-pill"><%= item.status %></span></p><p><%= item.specialization || 'Online consultation' %></p><% if(item.scheduledAtLabel){ %><p><strong>Appointment:</strong> <%= item.scheduledAtLabel %> India time</p><% } %><small><%= formatDateTime(item.requested_at) %> · <%= Math.floor(Number(item.actual_seconds)/60) %> min <%= Number(item.actual_seconds)%60 %> sec · ₹<%= Number(item.rate_per_minute).toFixed(2) %>/minute · ₹<%= Number(item.total_amount).toFixed(2) %></small><p>Payment: <%= item.demo_payment_status||item.payment_status %><% if(item.transaction_id){ %> · <%= item.transaction_id %><% } %></p></div></div><a class="button quiet" href="/consultations/<%= item.public_id %>"><%= item.status==='ACCEPTED'?'Open scheduled call':'Open consultation' %></a></article>
    <% }) %></div><% } else { %><div class="empty-card"><h3>No online consultations yet</h3><p><%= pageRole==='doctor'?'Requests from patients will appear here.':'Visit a verified doctor profile and choose online consultation to start.' %></p></div><% } %>
  </section>
</main><%- include('partials/footer') %>
<% if(pageRole==='doctor'){ %><script src="/consultation-schedule.js" defer></script><% } %>
