<%- include('partials/header', { title: 'Hospital dashboard | HealthConnect Bharat' }) %>
<main class="dashboard-wrap <%= profileOnly ? 'profile-screen hospital-profile-screen' : '' %> <%= sectionOnly ? 'section-screen hospital-section-only-appointments' : '' %>">
  <section class="panel doctor-overview" id="hospital-home"><span class="eyebrow">Hospital / healthcare organisation</span><h1><%= hospital.registered_name %></h1><p><%= hospital.city %><% if(hospital.state){ %>, <%= hospital.state %><% } %> · <span class="status-pill <%= hospital.verification_status==='VERIFIED'&&hospital.account_status==='active'?'':'pending' %>"><%= hospital.verification_status %></span></p><div class="doctor-stats"><article><span>Approved affiliated doctors</span><strong><%= Number(stats.doctors||0) %></strong></article><article><span>Today's appointments</span><strong><%= Number(stats.today_appointments||0) %></strong></article><article><span>Upcoming appointments</span><strong><%= Number(stats.upcoming_appointments||0) %></strong></article></div><% if(hospital.verification_status!=='VERIFIED'||hospital.account_status!=='active'){ %><div class="status-banner"><strong>Hospital workspace is awaiting administrator approval.</strong><p>Update your organisation profile and review status. Public directory listing and operational tools open after approval.</p><a href="/provider/status">Review application →</a></div><% } %><% if(hospital.review_reason){ %><p class="status-banner"><strong>Admin feedback:</strong> <%= hospital.review_reason %></p><% } %></section>
  <section class="panel workflow-panel" id="hospital-profile"><div class="section-heading"><div><span class="eyebrow">Organisation details</span><h2>Hospital profile</h2></div></div><form method="post" action="/hospital/profile" class="form-stack" data-change-save><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="two-col"><label>Registered name<input name="registeredName" maxlength="180" required value="<%= hospital.registered_name %>"></label><label>Licence / registration number<input name="licenceNumber" maxlength="120" value="<%= hospital.licence_number||'' %>"></label><label>Contact phone<input type="tel" name="phone" required value="<%= hospital.phone||'' %>"></label><label>City<input name="city" maxlength="100" required value="<%= hospital.city||'' %>"></label><label>State<input name="state" maxlength="100" value="<%= hospital.state||'' %>"></label><label>Postal code<input name="postalCode" maxlength="20" value="<%= hospital.postal_code||'' %>"></label><label>Authorised representative<input name="representativeName" maxlength="120" value="<%= hospital.representative_name||'' %>"></label></div><label class="consent-label"><input type="checkbox" name="publicPhone" <%= Number(hospital.public_phone) ? 'checked' : '' %>>Show this contact phone in the public hospital directory</label><label>Address<textarea name="address" maxlength="500" rows="2" required><%= hospital.address %></textarea></label><label>Departments<textarea name="departments" maxlength="4000" rows="2" placeholder="Only list departments available at your organisation"><%= hospital.departments||'' %></textarea></label><label>Services<textarea name="services" maxlength="4000" rows="2"><%= hospital.services||'' %></textarea></label><label>Facilities<textarea name="facilities" maxlength="4000" rows="2" placeholder="For example: laboratory, pharmacy, emergency room"><%= hospital.facilities||'' %></textarea></label><label>Accessibility information<textarea name="accessibility" maxlength="4000" rows="2"><%= hospital.accessibility||'' %></textarea></label><label>Public description<textarea name="description" maxlength="1000" rows="3"><%= hospital.public_description||'' %></textarea></label><p class="fineprint">Saving changed organisation information sends it back for administrator review before it is listed publicly.</p><button class="button primary" type="submit" data-change-submit hidden>Save hospital profile</button></form></section>
  <section class="panel workflow-panel" id="hospital-doctors"><div class="section-heading"><div><span class="eyebrow">Admin-approved affiliations</span><h2>Doctors</h2></div></div><% if(doctors.length){ %><div class="doctor-grid"><% doctors.forEach((doctor)=>{ %><article class="doctor-card"><img class="doctor-profile-photo" src="<%= doctor.profile_image_url||'/doctor-avatar.svg' %>" alt="Photo of <%= doctor.name %>"><h3><%= doctor.name %></h3><p><%= doctor.specialization||'Specialty not provided' %></p><p><%= doctor.qualification||'Qualification not provided' %></p></article><% }) %></div><% } else { %><div class="empty-card"><h3>No approved doctors affiliated</h3><p>Doctors appear after their professional profile and affiliation have both been approved.</p></div><% } %></section>
  <section class="panel workflow-panel" id="hospital-appointments"><div class="section-heading"><div><span class="eyebrow">Approved affiliated doctors</span><h2>Upcoming appointments</h2></div></div><% if(appointments.length){ %><div class="workflow-list"><% appointments.forEach((item)=>{ %><article class="workflow-card"><div><strong><%= item.doctor_name %> · <%= formatDateTime(item.starts_at) %></strong><p><%= item.consultation_type.replace('_',' ') %> · Ref <%= item.booking_reference %> · <span class="status-pill"><%= item.status %></span></p></div></article><% }) %></div><% } else { %><div class="empty-card"><h3>No upcoming appointments</h3><p>Only appointments linked to an approved affiliated doctor are included.</p></div><% } %></section>
  <section class="panel workflow-panel" id="hospital-facilities"><div class="section-heading"><div><span class="eyebrow">Registered details</span><h2>Services and facilities</h2></div></div><p><strong>Departments:</strong> <%= hospital.departments||'Not listed' %></p><p><strong>Services:</strong> <%= hospital.services||'Not listed' %></p><p><strong>Facilities:</strong> <%= hospital.facilities||'Not listed' %></p><p><strong>Accessibility:</strong> <%= hospital.accessibility||'Not listed' %></p></section>
</main><%- include('partials/footer') %>
