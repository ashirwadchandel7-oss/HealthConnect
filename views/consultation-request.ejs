<%- include('partials/header', { title: 'Request online consultation | HealthConnect Bharat' }) %>
<main class="directory-wrap"><a class="back-link" href="/doctors/<%= doctor.id %>">← Back to doctor</a><section class="panel consultation-consent-card">
  <div class="appointment-doctor"><img class="doctor-avatar" src="<%= doctor.profile_image_url||'/doctor-avatar.svg' %>" alt=""><div><span class="verified">✓ Verified doctor</span><h1><%= doctor.name %></h1><p><%= doctor.specialization %> · <%= doctor.qualification %><% if(doctor.years_experience!=null){ %> · <%= doctor.years_experience %> years' experience<% } %></p></div></div>
  <form method="post" action="/consultations/request" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="doctorId" value="<%= doctor.id %>">
  <h2>Choose your appointment time</h2><p>Choose one of the slots generated from this doctor’s availability. The appointment is booked immediately if the selected start time is still free. Calls continue until the doctor or patient ends them.</p>
  <% if(schedule.length){ const weekdays=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday']; %><p><strong>Doctor’s online hours:</strong> <%= schedule.map(slot => `${weekdays[Number(slot.weekday)]} ${slot.starts_at}–${slot.ends_at}${slot.second_starts_at ? ' and '+slot.second_starts_at+'–'+slot.second_ends_at : ''}`).join(' · ') %> (India time)</p><% } else { %><p>This doctor has not published online availability yet. Please check again after the doctor sets weekly hours.</p><% } %>
  <label>Available appointment slots (India time)<select name="scheduledAt" required <%= availableSlotDays.length ? '' : 'disabled' %>><option value="" selected disabled><%= availableSlotDays.length ? 'Choose a date and time' : 'No available slots in the next 30 days' %></option><% availableSlotDays.forEach((day)=>{ %><optgroup label="<%= day.dateLabel %>"><% day.slots.forEach((slot)=>{ %><option value="<%= slot.value %>"><%= slot.time %></option><% }) %></optgroup><% }) %></select></label>
  <p class="fineprint">Only times that fit the doctor’s hours and do not overlap another booked consultation are listed.</p>
  <h2>Before you request</h2><p>Demo rate: <strong>₹<%= Number(settings.rate_per_minute).toFixed(2) %> per minute</strong></p><p>The server measures the connected call duration and calculates the final amount when the call ends. You can then simulate a successful, failed, or cancelled demo payment. Demo Payment — No real money is charged.</p>
  <p class="fineprint">This service does not record audio or video. Do not use it for emergency care.</p>
  <label class="check-label"><input type="checkbox" name="billingConsent" value="yes" required> I understand that final demo billing uses the server-recorded call time at ₹<%= Number(settings.rate_per_minute).toFixed(2) %>/minute. Payment is requested after the call. No real money is charged.</label><button class="button primary" <%= availableSlotDays.length ? '' : 'disabled' %>>Book this date and time</button></form>
</section></main><%- include('partials/footer') %>
