<%- include('partials/header', { title: 'Request online consultation | HealthConnect Bharat' }) %>
<main class="directory-wrap"><a class="back-link" href="/doctors/<%= doctor.id %>">← Back to doctor</a><section class="panel consultation-consent-card">
  <div class="appointment-doctor"><img class="doctor-avatar" src="<%= doctor.profile_image_url||'/doctor-avatar.svg' %>" alt=""><div><span class="verified">✓ Verified doctor</span><h1><%= doctor.name %></h1><p><%= doctor.specialization %> · <%= doctor.qualification %><% if(doctor.years_experience!=null){ %> · <%= doctor.years_experience %> years' experience<% } %></p></div></div>
  <h2>Before you request</h2><p>Demo rate: <strong>₹<%= Number(settings.rate_per_minute).toFixed(2) %> per minute</strong></p><p>The server measures the connected call duration and calculates the final amount when the call ends. You can then simulate a successful, failed, or cancelled demo payment. Demo Payment — No real money is charged.</p>
  <p class="fineprint">This service does not record audio or video. Do not use it for emergency care.</p>
  <form method="post" action="/consultations/request" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="doctorId" value="<%= doctor.id %>"><label class="check-label"><input type="checkbox" name="billingConsent" value="yes" required> I understand that final demo billing uses the server-recorded call time at ₹<%= Number(settings.rate_per_minute).toFixed(2) %>/minute. Payment is requested after the call. No real money is charged.</label><button class="button primary">Send consultation request</button></form>
</section></main><%- include('partials/footer') %>
