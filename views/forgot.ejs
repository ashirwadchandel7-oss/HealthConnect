<%- include('partials/header',{title:'Password help | HealthConnect Bharat'}) %><main class="auth-layout single-auth"><section class="auth-card"><a class="back-link" href="/login">← Back to sign in</a><div class="auth-symbol">⌑</div><span class="eyebrow">Account help</span><h2><%= step==='reset'?'Choose a new password':'Reset your password' %></h2><p class="muted"><%= step==='reset'?(localOtpMode?'Development mode: no email is sent. If the account exists, use the local OTP shown below or in the VS Code terminal.':'If a verified account matches this email, Brevo accepts the reset email for delivery. Check Inbox and Spam. If no email arrives, confirm the address or account.'):'We’ll email you a secure one-time code if a verified account matches.' %></p><% if(error){ %><div class="form-error"><%= error %></div><% } %><form method="post" action="<%= step==='reset'?'/forgot-password/reset':'/forgot-password' %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Email address<input type="email" name="email" required value="<%= email||'' %>" placeholder="you@example.com" <%= step==='reset'&&email?'readonly':'' %>></label><% if(step==='reset'){ %><label>Six-digit email code<input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required placeholder="000000"></label><% if(devOtp){ %><p class="dev-code">Local development code: <strong><%= devOtp %></strong></p><% } %><label>New password<input type="password" name="password" minlength="10" autocomplete="new-password" required placeholder="At least 10 characters"></label><label>Confirm new password<input type="password" name="confirmPassword" minlength="10" autocomplete="new-password" required placeholder="Enter it again"></label><% } %><button class="button primary full"><%= step==='reset'?'Save new password':'Send reset code' %> <span>→</span></button></form><% if(step==='reset'){ %><form method="post" action="/forgot-password" class="resend-form" data-seconds="<%= resendWaitSeconds || 0 %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="email" value="<%= email||'' %>"><button class="text-link" type="submit" data-otp-countdown data-seconds="<%= resendWaitSeconds || 0 %>" data-ready-label="Send another code" data-countdown-prefix="Send another code in " <%= resendWaitSeconds > 0 ? 'disabled' : '' %>><span data-countdown-label>Send another code</span></button></form><% } %><div class="auth-switch"><a href="/login">Return to sign in</a></div></section></main><%- include('partials/footer') %>
