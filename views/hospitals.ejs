<%- include('partials/header', { title: 'Hospitals | HealthConnect Bharat' }) %>
<main class="directory-wrap"><div class="directory-intro"><span class="eyebrow">Verified care organisations</span><h1>Find a hospital <em>near you.</em></h1><p>Only organisations approved by the administrator are listed.</p></div>
  <form class="directory-search" method="get" action="/hospitals"><label>City<input name="city" value="<%= city %>" maxlength="100" placeholder="Any city"></label><label>Department<input name="department" value="<%= department %>" maxlength="100" placeholder="e.g. Cardiology"></label><label>Service<input name="service" value="<%= service %>" maxlength="100" placeholder="e.g. Imaging"></label><button class="button primary">Search →</button></form>
  <% if (hospitals.length) { %><div class="doctor-grid"><% hospitals.forEach((hospital) => { %><article class="doctor-card"><h2><%= hospital.registered_name %></h2><p><%= hospital.address %><% if (hospital.city) { %>, <%= hospital.city %><% } %><% if (hospital.state) { %>, <%= hospital.state %><% } %> <%= hospital.postal_code || '' %></p><% if (hospital.departments) { %><p><strong>Departments:</strong> <%= hospital.departments %></p><% } %><% if (hospital.services) { %><p><strong>Services:</strong> <%= hospital.services %></p><% } %><% if (hospital.facilities) { %><p><strong>Facilities:</strong> <%= hospital.facilities %></p><% } %><% if (hospital.accessibility) { %><p><strong>Accessibility:</strong> <%= hospital.accessibility %></p><% } %><% if(hospital.public_phone){ %><p><strong>Public contact:</strong> <a href="tel:<%= hospital.public_phone %>"><%= hospital.public_phone %></a></p><% } %><span class="verified">✓ Verified organisation</span></article><% }) %></div><% } else { %><div class="empty-card"><h2>No approved hospitals match</h2><p>Try another city or department.</p></div><% } %>
  <nav class="pagination" aria-label="Hospital pages"><% if(page>1){ %><a class="button quiet" href="/hospitals?city=<%= encodeURIComponent(city) %>&department=<%= encodeURIComponent(department) %>&service=<%= encodeURIComponent(service) %>&page=<%= page-1 %>">← Previous</a><% } %><span>Page <%= page %></span><% if(hasNext){ %><a class="button quiet" href="/hospitals?city=<%= encodeURIComponent(city) %>&department=<%= encodeURIComponent(department) %>&service=<%= encodeURIComponent(service) %>&page=<%= page+1 %>">Next →</a><% } %></nav>
</main><%- include('partials/footer') %>
