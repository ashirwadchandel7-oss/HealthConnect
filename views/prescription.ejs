<%- include('partials/header', { title: 'Prescription | HealthConnect Bharat' }) %>
<main class="dashboard-wrap"><article class="panel prescription-sheet"><a class="back-link" href="/dashboard">← Back to dashboard</a><span class="eyebrow">Clinician-issued record</span><h1>Prescription</h1><p>Issued by Dr. <%= prescription.doctor_name %> · <%= prescription.specialization || 'Doctor' %></p><p><%= formatDateTime(prescription.issued_at) %><% if(prescription.booking_reference){ %> · Appointment <%= prescription.booking_reference %><% } %></p><% if(prescription.amended_from){ %><p>This version amends an earlier prescription. <a href="/prescriptions/<%= prescription.amended_from %>">View previous version →</a></p><% } %><% if(prescription.medicines.length){ %><h2>Medicines</h2><div class="table-wrap"><table><thead><tr><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Duration</th><th>Instructions</th></tr></thead><tbody><% prescription.medicines.forEach((medicine)=>{ %><tr><td><%= medicine.name %></td><td><%= medicine.dosage || 'As directed' %></td><td><%= medicine.frequency || 'As directed' %></td><td><%= medicine.duration || 'As directed' %></td><td><%= medicine.instructions || '—' %></td></tr><% }) %></tbody></table></div><% } %><% if(prescription.additional_notes){ %><h2>Additional notes</h2><p class="record-notes"><%= prescription.additional_notes %></p><% } %><% if(!prescription.medicines.length){ %><pre><%= prescription.prescription_text %></pre><% } %><button class="button quiet" type="button" data-print>Print / Save as PDF</button><p class="fineprint">For questions about this prescription, contact the issuing doctor. Do not change your medication without clinician guidance.</p></article></main><%- include('partials/footer') %>
