<%- include('partials/header', { title: 'Confirm doctor profile changes | HealthConnect Bharat' }) %>
<main class="auth-wrap"><section class="auth-card"><a class="back-link" href="/profile">← Back to profile</a><span class="eyebrow">Email confirmation</span><h1>Confirm your changes</h1><p>A six-digit code was requested for <strong><%= email %></strong>. Once confirmed, your updated profile goes to the administrator for review and remains pending until approved.</p>
  <% if(error){ %><div class="flash error" role="alert"><%= error %></div><% } %>
  <% if(devOtp){ %><p class="status-banner">Development OTP: <strong><%= devOtp %></strong></p><% } %>
  <form method="post" action="/doctor/profile/change/verify" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Six-digit email code<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required></label><button class="button primary">Verify and submit for review</button></form>
  <form method="post" action="/doctor/profile/change/resend" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button quiet" data-resend-button <%= resendWaitSeconds > 0 ? 'disabled' : '' %>><span data-resend-label><%= resendWaitSeconds > 0 ? `Resend code in ${resendWaitSeconds}s` : 'Resend code' %></span></button></form>
</section></main><script>document.addEventListener('DOMContentLoaded',()=>{let left=<%= Number(resendWaitSeconds)||0 %>;const button=document.querySelector('[data-resend-button]');const label=document.querySelector('[data-resend-label]');if(!button||!label||left<=0)return;const timer=setInterval(()=>{left-=1;if(left<=0){clearInterval(timer);button.disabled=false;label.textContent='Resend code';return;}label.textContent=`Resend code in ${left}s`;},1000);});</script>
<%- include('partials/footer') %>
