<%- include('partials/header', { title: 'Consultation operations | HealthConnect Bharat' }) %>
<main class="dashboard-wrap">
  <section class="panel"><span class="eyebrow">Administrator operations</span><h1>Consultations and demo payments</h1><p>Configure the displayed consultation rate and maximum call length.</p>
    <% if(!config){ %><div class="status-banner"><strong>Video setup required</strong><p>Configure PAYMENT_MODE=MOCK and LiveKit credentials to enable browser-to-browser video. No real payment provider is used.</p></div><% } %>
    <form method="post" action="/admin/consultations/settings" class="form-stack admin-consult-settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Rate per minute (INR)<input name="ratePerMinute" type="number" min="1" max="100000" step="0.01" value="<%= Number(settings.rate_per_minute).toFixed(2) %>" required></label><label>Maximum call minutes<input name="maxMinutes" type="number" min="1" max="240" step="1" value="<%= settings.max_minutes %>" required></label><label class="check-label"><input type="checkbox" name="enabled" value="1" <%= settings.enabled?'checked':'' %>> Allow online consultations</label><button class="button primary">Save consultation settings</button></form>
    <p class="status-banner"><strong>Demo Payment — No real money is charged.</strong> The mock wallet stores a demo result only. Patient-paid demo earnings are shown in full to the doctor; no platform fee or payout is processed.</p>
  </section>
  <section class="panel workflow-panel"><h2>Recent sessions and demo transaction monitoring</h2><% if(consultations.length){ %><div class="workflow-list"><% consultations.forEach((item)=>{ %><article class="workflow-card"><div><strong><%= item.patient_name %> ↔ <%= item.doctor_name %></strong><p><%= item.status %> · Demo payment <%= item.transaction_status||item.payment_status %></p><p><%= Math.floor(Number(item.actual_seconds)/60) %> min <%= Number(item.actual_seconds)%60 %> sec · ₹<%= Number(item.rate_per_minute).toFixed(2) %>/min · Final amount ₹<%= Number(item.total_amount).toFixed(2) %> · Doctor demo earnings ₹<%= Number(item.doctor_earning_amount).toFixed(2) %></p><small>Transaction <%= item.transaction_id||'not generated' %> · Requested <%= formatDateTime(item.requested_at) %></small></div><a class="button quiet" href="/consultations/<%= item.public_id %>">Open</a></article><% }) %></div><% } else { %><p class="muted">No consultations have been recorded.</p><% } %></section>
</main><%- include('partials/footer') %>
