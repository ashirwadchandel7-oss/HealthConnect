<%- include('partials/header', { title: 'Online consultation | HealthConnect Bharat' }) %>
<main class="directory-wrap consultation-detail" data-consultation="<%= consultation.public_id %>" data-role="<%= pageRole %>" data-csrf="<%= csrfToken %>" data-status="<%= consultation.status %>" data-rate="<%= Number(consultation.rate_per_minute) %>">
  <a class="back-link" href="/consultations">← Back to consultations</a>
  <section class="panel consultation-head">
    <div class="appointment-doctor"><img class="doctor-avatar" src="<%= pageRole==='doctor'?(consultation.patient_photo||'/patient-avatar.svg'):(consultation.doctor_photo||'/doctor-avatar.svg') %>" alt=""><div><span class="eyebrow">Appointment type: Online consultation</span><h1><%= pageRole==='doctor'?consultation.patient_name:consultation.doctor_name %></h1><p><%= consultation.specialization||'' %><% if(consultation.qualification){ %> · <%= consultation.qualification %><% } %></p></div></div>
    <span class="status-pill"><%= consultation.status %></span>
    <div class="doctor-stats"><article><span>Rate</span><strong>₹<%= Number(consultation.rate_per_minute).toFixed(2) %>/min</strong></article><article><span>Call duration</span><strong>Until ended</strong></article><article><span>Payment</span><strong><%= consultation.payment_status %></strong></article></div>
  </section>

  <% if(consultation.status==='REQUESTED'&&pageRole==='doctor'){ %>
    <section class="panel action-stack"><h2>Consultation request</h2><p>Patient requested: <strong><%= scheduledAtLabel %> India time</strong>. Accept this time or change it to another available time. The secure call opens 15 minutes before the confirmed appointment.</p><form method="post" action="/consultations/<%= consultation.public_id %>/accept" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Appointment date and time (India time)<input type="datetime-local" name="scheduledAt" min="<%= minimumScheduleTime %>" value="<%= requestedScheduleInput %>" required></label><button class="button primary">Accept and schedule</button></form><form method="post" action="/consultations/<%= consultation.public_id %>/reject"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button quiet">Decline request</button></form></section>
  <% } %>

  <% if(['REQUESTED','ACCEPTED','READY'].includes(consultation.status)&&!consultation.started_at&&pageRole==='patient'){ %>
    <section class="panel action-stack"><h2>Online consultation</h2><p>You can cancel this consultation before the call starts. After cancellation, you can send another online consultation request.</p><form method="post" action="/consultations/<%= consultation.public_id %>/cancel" data-cancel-consultation><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button danger">Cancel this consultation</button></form></section>
  <% } %>

  <% if(consultation.status==='ACCEPTED'&&consultation.scheduled_at){ %>
    <section class="panel scheduled-consultation" data-scheduled-consultation>
      <span class="eyebrow">Appointment scheduled</span>
      <h2><%= scheduledAtLabel %> India time</h2>
      <p data-appointment-countdown>The call button will activate 15 minutes before this time. Both you and the other participant can join from this page.</p>
    </section>
  <% } %>
  <% if(consultation.status==='REQUESTED'&&pageRole==='patient'&&consultation.scheduled_at){ %>
    <section class="panel scheduled-consultation"><span class="eyebrow">Requested appointment time</span><h2><%= scheduledAtLabel %> India time</h2><p>The doctor will confirm this time or propose another available slot.</p></section>
  <% } %>

  <% if(['ACCEPTED','READY','ACTIVE'].includes(consultation.status)){ %>
    <section class="panel call-toolbar">
      <div><span class="eyebrow">Live video and audio</span><h2>Consultation room</h2><p data-call-status role="status"><%= consultation.status==='ACTIVE'?'Call active. Duration is tracked by the server.':consultation.status==='ACCEPTED'&&consultation.scheduled_at?'The call is available 15 minutes before the appointment and continues until ended.':'Join when both you and the other participant are ready.' %></p></div>
      <p>Call duration: <strong data-call-duration>00:00</strong> · Estimated demo amount: <strong data-call-estimate>₹0.00</strong></p>
      <p class="fineprint">The official duration and final amount are calculated by the server. Demo rate ₹<%= Number(consultation.rate_per_minute).toFixed(2) %> per minute; no payment is due until after the call.</p>
      <div class="call-controls"><button class="button primary" type="button" data-join-call <%= consultation.status==='ACCEPTED'&&consultation.scheduled_at&&!canJoin?'disabled':'' %>>Join video consultation</button><button class="button quiet" type="button" data-toggle-mic disabled>Mute microphone</button><button class="button quiet" type="button" data-toggle-camera disabled>Turn camera off</button><button class="button quiet" type="button" data-enable-audio hidden>Enable call audio</button></div>
      <div class="video-grid"><video data-remote-video autoplay playsinline></video><video data-local-video autoplay playsinline muted></video></div>
      <form method="post" action="/consultations/<%= consultation.public_id %>/end" data-end-consultation><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button danger">End consultation</button></form>
    </section>
  <% } %>

  <% if(consultation.status==='SETTLING'&&pageRole==='patient'){ %>
    <section class="panel"><span class="eyebrow">UPI payment</span><h2>Consultation finished</h2><p>Call duration: <strong><%= Math.floor(Number(consultation.actual_seconds)/60) %> min <%= Number(consultation.actual_seconds)%60 %> sec</strong></p><p>₹<%= Number(consultation.rate_per_minute).toFixed(2) %>/minute · Payable amount: <strong>₹<%= Number(consultation.total_amount).toFixed(2) %></strong></p>
      <% if(consultation.payment_proof_status==='PENDING'){ %><p class="status-banner">Payment screenshot sent. Waiting for the doctor to review it.</p><% } else { %>
      <% if(consultation.payment_proof_status==='REJECTED'){ %><p class="form-error">Doctor could not confirm the previous screenshot. Upload a clear payment screenshot again.</p><% } %>
      <form method="post" action="/consultations/<%= consultation.public_id %>/payment-proof" class="form-stack" data-consult-payment-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><fieldset class="payment-choice"><legend>Choose how you paid</legend><% if(consultation.upi_id){ %><label class="check-label"><input type="radio" name="paymentMethod" value="UPI_ID" required> Pay to UPI ID <strong><%= consultation.upi_id %></strong></label><% } %><% if(consultation.qr_image_url){ %><label class="check-label"><input type="radio" name="paymentMethod" value="QR" required> Pay by QR code</label><img class="doctor-payment-qr payment-qr-large" src="<%= consultation.qr_image_url %>" alt="Doctor's UPI QR code"><% } %></fieldset><label>Payment screenshot<input type="file" accept="image/jpeg,image/png,image/webp" required data-proof-file><input type="hidden" name="proofImageData" data-proof-data><small>JPG, PNG or WebP, up to 2 MB.</small></label><button class="button primary">Send payment proof to doctor</button></form><% } %>
    </section>
  <% } %>
  <% if(consultation.payment_proof&&pageRole==='doctor'){ %><section class="panel"><h2>Patient payment proof · ₹<%= Number(consultation.total_amount).toFixed(2) %></h2><p>Payment option: <%= consultation.payment_method==='QR'?'QR code':'UPI ID' %> · Review: <%= consultation.payment_proof_status %></p><img class="doctor-payment-qr payment-qr-large" src="<%= consultation.payment_proof_data_url %>" alt="Patient's payment screenshot"><% if(consultation.payment_proof_status==='PENDING'){ %><form method="post" action="/consultations/<%= consultation.public_id %>/payment-proof/review" class="proof-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary" name="action" value="approve">Confirm payment</button><button class="button quiet" name="action" value="reject">Ask for another screenshot</button></form><% } %></section><% } %>

  <% if(['COMPLETED','FAILED','CANCELLED','REJECTED','EXPIRED'].includes(consultation.status)){ %>
    <section class="panel"><h2><%= consultation.status==='COMPLETED'?'Consultation complete':'Consultation '+consultation.status.toLowerCase() %></h2><p>Server-recorded duration: <%= Math.floor(Number(consultation.actual_seconds)/60) %> min <%= Number(consultation.actual_seconds)%60 %> sec · Rate: ₹<%= Number(consultation.rate_per_minute).toFixed(2) %>/minute · Amount: ₹<%= Number(consultation.total_amount).toFixed(2) %></p><p>Payment: <strong><%= consultation.demo_payment_status||consultation.payment_status %></strong><% if(consultation.transaction_id){ %> · Demo transaction: <strong><%= consultation.transaction_id %></strong><% } %></p><p class="fineprint">Demo Payment — No real money is charged.</p></section>
  <% } %>
</main>
<% if(['ACCEPTED','READY','ACTIVE'].includes(consultation.status)){ %><script src="https://cdn.jsdelivr.net/npm/livekit-client@2/dist/livekit-client.umd.min.js" defer></script><script src="/consultation-room.js" defer></script><% } %>
<% if(consultation.status==='REQUESTED'){ %><script src="/consultation-status.js" defer></script><% } %>
<script>document.querySelector('[data-consult-payment-form]')?.addEventListener('submit',async event=>{const form=event.currentTarget;const file=form.querySelector('[data-proof-file]').files[0];if(!file)return;event.preventDefault();if(file.size>2*1024*1024){alert('Screenshot must be 2 MB or smaller.');return;}const data=await new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.onerror=reject;reader.readAsDataURL(file);});form.querySelector('[data-proof-data]').value=data;form.submit();});</script>
<%- include('partials/footer') %>
