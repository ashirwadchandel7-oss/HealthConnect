PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# TiDB Cloud: use the public endpoint, port 4000, and TLS.
DB_HOST=your-tidb-hostname
DB_PORT=4000
DB_NAME=test
DB_USER=your-tidb-username
DB_PASSWORD=your-tidb-password
DB_SSL=true
DB_CREATE_DATABASE=false

# Brevo SMTP credentials. Keep blank for local-only OTP testing.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=verified-sender@example.com
SMTP_FROM_NAME=HealthConnect Bharat

OTP_TTL_MINUTES=10
OTP_VERIFY_COOLDOWN_SECONDS=120
OTP_COOLDOWN_SECONDS=120
OTP_MAX_ATTEMPTS=5
CANCELLATION_CUTOFF_HOURS=24

# Optional: existing verified account to promote using npm run admin:provision.
ADMIN_EMAIL=

# Online video consultations. Mock payments never charge real money.
PAYMENT_MODE=MOCK
# In-person appointment payments use demo UPI details configured in the doctor dashboard.

# Optional OpenAI-compatible medical assistant. Leave blank until a provider is selected.
MEDICAL_AI_BASE_URL=
MEDICAL_AI_API_KEY=
MEDICAL_AI_MODEL=

# LiveKit Cloud/self-hosted server. Use the WSS URL supplied by your provider.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional ICE overrides. LiveKit Cloud includes TURN connectivity by default.
WEBRTC_STUN_SERVER=
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
# Configure this as a TURN REST shared secret; only short-lived derived credentials reach the browser.
WEBRTC_TURN_CREDENTIAL=
